# ----- Host port mappings (change any that clash with existing services) -----
WEB_PORT=3000
DB_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PDF_WORKER_PORT=4000

# ----- Web app -----
DATABASE_URL=postgresql://goyapp:goyapp@localhost:5432/goyapp
AUTH_SECRET=change-me-use-openssl-rand-base64-32
# In production, AUTH_URL must be the PUBLIC URL (https://your.domain) — redirects (sign-out, callbacks) use it
AUTH_URL=http://localhost:3000
PDF_WORKER_URL=http://localhost:4000
WORKER_SECRET=change-me-shared-between-web-and-pdf-worker

# ----- MinIO (S3-compatible storage) -----
# S3_ENDPOINT is the internal URL the server uses to talk to MinIO
# S3_PUBLIC_ENDPOINT is the URL the browser uses (must match MINIO_PORT if behind proxy, update here)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=goyapp
S3_SECRET_KEY=goyapp-secret
S3_BUCKET=goyapp

# ----- Postgres -----
POSTGRES_USER=goyapp
POSTGRES_PASSWORD=goyapp
POSTGRES_DB=goyapp
