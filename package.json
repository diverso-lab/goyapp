{
  "name": "goyapp",
  "private": true,
  "version": "0.1.0",
  "description": "Online poster editor — Next.js + Fabric.js",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @goyapp/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:push": "pnpm --filter @goyapp/web db:push",
    "db:seed": "pnpm --filter @goyapp/web db:seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
